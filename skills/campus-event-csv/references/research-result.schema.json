{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus event research result (intermediate, not approved CSV)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events"
  ],
  "$defs": {
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "field": {
      "enum": [
        "title",
        "organizer",
        "category",
        "tags",
        "description",
        "source_url",
        "registration_start",
        "registration_deadline",
        "event_start",
        "event_end",
        "location",
        "eligibility",
        "notes",
        "year",
        "edition",
        "stage"
      ]
    },
    "fieldList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "identity",
          "fields",
          "sources",
          "evidence",
          "missing",
          "conflicts",
          "last_verified",
          "metrics",
          "deferred"
        ],
        "properties": {
          "item": {
            "type": "integer",
            "minimum": 1
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "edition",
              "stage",
              "resolved"
            ],
            "properties": {
              "year": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1900,
                "maximum": 9999
              },
              "edition": {
              "$ref": "#/$defs/text",
              "description": "届次（例如第十六届）。原文未给出则为 null，不能把赛事名称填作届次。"
              },
              "stage": {
                "$ref": "#/$defs/text"
              },
              "resolved": {
                "type": "boolean"
              }
            }
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "organizer",
              "category",
              "tags",
              "description",
              "source_url",
              "registration_start",
              "registration_deadline",
              "event_start",
              "event_end",
              "location",
              "eligibility",
              "notes"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/text"
              },
              "organizer": {
                "$ref": "#/$defs/text"
              },
              "category": {
                "$ref": "#/$defs/text"
              },
              "tags": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "$ref": "#/$defs/text"
              },
              "source_url": {
                "$ref": "#/$defs/url"
              },
              "registration_start": {
                "$ref": "#/$defs/date"
              },
              "registration_deadline": {
                "$ref": "#/$defs/date"
              },
              "event_start": {
                "$ref": "#/$defs/date"
              },
              "event_end": {
                "$ref": "#/$defs/date"
              },
              "location": {
                "$ref": "#/$defs/text"
              },
              "eligibility": {
                "$ref": "#/$defs/text"
              },
              "notes": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "title",
                "kind",
                "read_state",
                "supports"
              ],
              "properties": {
                "url": {
                  "$ref": "#/$defs/url"
                },
                "title": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "official",
                    "third_party",
                    "user_provided"
                  ]
                },
                "read_state": {
                  "enum": [
                    "original_read",
                    "user_text",
                    "unread"
                  ]
                },
                "supports": {
                  "$ref": "#/$defs/fieldList"
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "source_url",
                "excerpt"
              ],
              "properties": {
                "field": {
                  "$ref": "#/$defs/field"
                },
                "source_url": {
                  "$ref": "#/$defs/url"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              }
            }
          },
          "missing": {
            "$ref": "#/$defs/fieldList"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "search_queries",
              "original_documents_read",
              "follow_up_queries"
            ],
            "properties": {
              "search_queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "original_documents_read": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "follow_up_queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "deferred": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
